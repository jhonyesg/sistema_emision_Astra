; Astra RTMP - Plantilla de configuracion
;
; Copia este archivo como `cadena_rcn.ini` y rellena los valores reales
; de cada canal. NO commitees `cadena_rcn.ini` al repositorio.
;
; Nota: la seccion [servidor] define defaults por despliegue (Title,
; Network, Night_Restart, Auto_Restart, Start_All_On_Boot). Ver README.md
; para el detalle.

[servidor]
FFMPEG_PATH=/usr/bin/ffmpeg
Title=Astra RTMP
Network=enp2s0
Night_Restart=true
Auto_Restart=true
Start_All_On_Boot=true

[01_Canal_Principal]
Original_URL=srt://<origen-host>:<puerto>?passphrase=<clave>&latency=4000000&mode=caller&transtype=live
Destination_URL=rtmp://127.0.0.1:1935/live/<stream-key>
VAAPI_DRIVER=i965
FFMPEG_PRE_OPTIONS=-timeout 15000000 -thread_queue_size 16384 -fflags +discardcorrupt+flush_packets+nobuffer -err_detect ignore_err -analyzeduration 10000000 -probesize 10000000
FFMPEG_POST_OPTIONS=-vf scale=720:408 -r 30 -c:v libx264 -preset veryfast -tune zerolatency -b:v 1000k -maxrate 1100k -bufsize 4000k -g 60 -bf 0 -c:a aac -b:a 128k -ar 44100 -ac 2 -muxdelay 0 -muxpreload 0 -f flv
autostart=true

[02_HTTP_Stream]
Original_URL=http://<origen-host>:<puerto>/play/<stream-id>
Destination_URL=rtmp://127.0.0.1:1935/live/<stream-key>
VAAPI_DRIVER=i965
FFMPEG_PRE_OPTIONS=-vaapi_device /dev/dri/renderD128 -timeout 10000000 -thread_queue_size 8192 -fflags +discardcorrupt+flush_packets -err_detect ignore_err -reconnect 1 -reconnect_streamed 1 -reconnect_delay_max 5 -analyzeduration 5000000 -probesize 5000000
FFMPEG_POST_OPTIONS=-vf format=nv12,hwupload,scale_vaapi=720:408 -r 30 -c:v h264_vaapi -b:v 1000k -maxrate 1100k -bufsize 2000k -g 60 -bf 0 -c:a aac -b:a 128k -ar 44100 -ac 2 -muxdelay 0 -muxpreload 0 -f flv
